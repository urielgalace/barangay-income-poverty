{% extends "base.html.j2" %}
{% block main %}
<div class="wrap">
  <div class="page-title">
    {% if n_versions > 1 %}
    <div class="eyebrow">Version History</div>
    <h1>What changed, and when</h1>
    <p class="lede">Choose a version to see what was added, what was fixed, and how far the numbers moved.</p>
    {% else %}
    <h1>Version History</h1>
    {% endif %}
  </div>
  {% if n_versions > 1 %}
  <div class="history">
    <div>
      <div class="vcompare">
        <div class="field"><label for="cmp-from">Compare from</label><select id="cmp-from"></select></div>
        <span class="arrow" aria-hidden="true">→</span>
        <div class="field"><label for="cmp-to">To</label><select id="cmp-to"></select></div>
      </div>
      <div id="vmain" style="display:grid;grid-template-columns:minmax(0,1fr);gap:6px;margin-top:22px"></div>
    </div>
    <div class="rail" id="rail"></div>
  </div>
  <section class="block" style="margin-top:40px">
    <header><h2>Everything added to the project, by date</h2><p class="small">Taken from each file's own date. Raw files themselves are not republished, and the <a href="methodology.html#sources">source list</a> has their checksums.</p></header>
    <ol class="tl" id="full-log"></ol>
  </section>
  {% else %}
  <div id="vmain" style="display:grid;grid-template-columns:minmax(0,1fr);gap:6px;max-width:820px"></div>
  {% endif %}
</div>
{% endblock %}
{% block scripts %}<script type="module" src="assets/js/versions.js?b={{ build }}"></script>{% endblock %}
